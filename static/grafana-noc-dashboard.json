{
  "__inputs": [
    {
      "name": "DS_PROMETHEUS",
      "label": "Prometheus",
      "description": "Prometheus Datasource (Uptime Kuma, Node Exporter, Beszel, Dazzle)",
      "type": "datasource",
      "pluginId": "prometheus",
      "pluginName": "Prometheus"
    }
  ],
  "annotations": { "list": [] },
  "description": "Homelab NOC Statusmonitor fuer 8-10 Zoll Android-Tablet im Kiosk-Modus (Uptime Kuma, Beszel, Dazzle, Node Exporter)",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 0,
  "id": null,
  "links": [],
  "liveNow": true,
  "Refresh": "10s",
  "refresh": "10s",
  "schemaVersion": 39,
  "style": "dark",
  "tags": ["noc", "homelab", "kiosk", "tablet", "prometheus", "uptime-kuma", "beszel", "dazzle"],
  "templating": { "list": [] },
  "time": { "from": "now-15m", "to": "now" },
  "timepicker": { "hidden": true },
  "timezone": "Europe/Berlin",
  "title": "Homelab NOC Tablet Monitor",
  "uid": "moritz-homelab-noc-v1",
  "version": 1,
  "panels": [
    {
      "id": 1,
      "title": "01 · DIENSTE ONLINE (UPTIME KUMA)",
      "type": "stat",
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [
        {
          "refId": "A",
          "expr": "count(monitor_status{job=\"uptime-kuma\"} == 1)",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "#EF4444", "value": null },
              { "color": "#10B981", "value": 18 }
            ]
          }
        }
      },
      "options": {
        "colorMode": "background_solid",
        "graphMode": "none",
        "justifyMode": "center",
        "textMode": "value_and_name"
      }
    },
    {
      "id": 2,
      "title": "02 · HOSTS ONLINE (BESZEL)",
      "type": "stat",
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [
        {
          "refId": "A",
          "expr": "count(up{job=~\"beszel|node-exporter\"} == 1)",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "#EF4444", "value": null },
              { "color": "#10B981", "value": 5 }
            ]
          }
        }
      },
      "options": {
        "colorMode": "background_solid",
        "graphMode": "none",
        "justifyMode": "center"
      }
    },
    {
      "id": 3,
      "title": "03 · CONTAINER HEALTHY (DAZZLE)",
      "type": "stat",
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [
        {
          "refId": "A",
          "expr": "count(container_health_status{status=\"healthy\"} == 1)",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "#EF4444", "value": null },
              { "color": "#10B981", "value": 42 }
            ]
          }
        }
      },
      "options": {
        "colorMode": "background_solid",
        "graphMode": "none",
        "justifyMode": "center"
      }
    },
    {
      "id": 4,
      "title": "04 · SSL-ZERTIFIKATE (UPTIME KUMA)",
      "type": "stat",
      "gridPos": { "h": 4, "w": 6, "x": 18, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [
        {
          "refId": "A",
          "expr": "min(monitor_cert_days_remaining{job=\"uptime-kuma\"})",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "type": "range",
              "options": {
                "from": 15,
                "to": 9999,
                "result": { "text": "OK", "color": "#10B981" }
              }
            },
            {
              "type": "range",
              "options": {
                "from": 7,
                "to": 14,
                "result": { "text": "WARNUNG", "color": "#F59E0B" }
              }
            },
            {
              "type": "range",
              "options": {
                "from": 0,
                "to": 6,
                "result": { "text": "KRITISCH", "color": "#EF4444" }
              }
            }
          ]
        }
      },
      "options": {
        "colorMode": "background_solid",
        "graphMode": "none",
        "justifyMode": "center"
      }
    },
    {
      "id": 5,
      "title": "ZEILE 2 · KRITISCHE DIENSTE (VAULTWARDEN · IMMICH · HOME ASSISTANT · GITEA · TRAEFIK · WIREGUARD)",
      "type": "stat",
      "gridPos": { "h": 4, "w": 24, "x": 0, "y": 4 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [
        {
          "refId": "A",
          "expr": "monitor_status{job=\"uptime-kuma\", monitor_name=~\"Vaultwarden|Immich|Home Assistant|Gitea|Traefik|WireGuard\"}",
          "legendFormat": "{{monitor_name}}",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "type": "value",
              "options": {
                "1": { "text": "ONLINE", "color": "#10B981" },
                "0": { "text": "OFFLINE", "color": "#EF4444" }
              }
            }
          ]
        }
      },
      "options": {
        "colorMode": "background_solid",
        "graphMode": "none",
        "orientation": "horizontal"
      }
    },
    {
      "id": 6,
      "title": "CPU-LAST (<70% GRÜN · 70-85% GELB · >85% ROT)",
      "type": "gauge",
      "gridPos": { "h": 5, "w": 6, "x": 0, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [
        {
          "refId": "A",
          "expr": "100 - (avg by (instance) (rate(node_cpu_seconds_total{mode=\"idle\"}[2m])) * 100)",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "#10B981", "value": null },
              { "color": "#F59E0B", "value": 70 },
              { "color": "#EF4444", "value": 85 }
            ]
          }
        }
      }
    },
    {
      "id": 7,
      "title": "ARBEITSSPEICHER (<75% GRÜN · 75-90% GELB · >90% ROT)",
      "type": "gauge",
      "gridPos": { "h": 5, "w": 6, "x": 6, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [
        {
          "refId": "A",
          "expr": "(1 - (node_memory_MemAvailable_bytes / node_memory_MemTotal_bytes)) * 100",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "#10B981", "value": null },
              { "color": "#F59E0B", "value": 75 },
              { "color": "#EF4444", "value": 90 }
            ]
          }
        }
      }
    },
    {
      "id": 8,
      "title": "DATENTRÄGER (<80% GRÜN · 80-90% GELB · >90% ROT)",
      "type": "gauge",
      "gridPos": { "h": 5, "w": 6, "x": 12, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [
        {
          "refId": "A",
          "expr": "100 - ((node_filesystem_avail_bytes{mountpoint=\"/\"} / node_filesystem_size_bytes{mountpoint=\"/\"}) * 100)",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "#10B981", "value": null },
              { "color": "#F59E0B", "value": 80 },
              { "color": "#EF4444", "value": 90 }
            ]
          }
        }
      }
    },
    {
      "id": 9,
      "title": "NETZWERK INBOUND / OUTBOUND",
      "type": "stat",
      "gridPos": { "h": 5, "w": 6, "x": 18, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [
        {
          "refId": "A",
          "expr": "rate(node_network_receive_bytes_total{device=~\"eth0|eno1|ens18\"}[2m]) * 8",
          "legendFormat": "Inbound"
        },
        {
          "refId": "B",
          "expr": "rate(node_network_transmit_bytes_total{device=~\"eth0|eno1|ens18\"}[2m]) * 8",
          "legendFormat": "Outbound"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "bps" }
      },
      "options": {
        "colorMode": "value",
        "graphMode": "area"
      }
    },
    {
      "id": 10,
      "title": "ZEILE 4 · CONTAINER-GESUNDHEIT & TOP RESTARTS (24H · DAZZLE)",
      "type": "bargauge",
      "gridPos": { "h": 4, "w": 24, "x": 0, "y": 13 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [
        {
          "refId": "A",
          "expr": "topk(5, round(increase(container_start_time_seconds{name!=\"\"}[24h]) > 0))",
          "legendFormat": "{{name}}",
          "instant": true
        }
      ]
    },
    {
      "id": 11,
      "title": "ZEILE 5 · WARNUNGEN & INCIDENTS (MAX. 5 AKTUELLE EREIGNISSE)",
      "type": "alertlist",
      "gridPos": { "h": 4, "w": 24, "x": 0, "y": 17 },
      "options": {
        "maxItems": 5,
        "sortOrder": 3,
        "stateFilter": {
          "firing": true,
          "pending": true,
          "noData": false,
          "normal": false,
          "error": true
        }
      }
    }
  ]
}
